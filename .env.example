# ============================================================
# Sense2Act 后端环境变量样例。复制为 .env 使用;.env 永不入库(.gitignore 已排除)。
# 本地开发:POSTGRES_PASSWORD / JWT_SECRET 可先用默认值。
# 服务器部署:JWT_SECRET、INTERNAL_API_KEY、POSTGRES_PASSWORD 必须改成强值。
# ============================================================

# --- 数据库 ---
POSTGRES_USER=sense2act
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=sense2act

# --- 认证 ---
# JWT 签名密钥,至少 32 字符;生产必填强随机值(否则启动被拒绝)
JWT_SECRET=
# token 有效期
JWT_TTL=12h

# --- 内部接口(api-design §9)---
# 不配置则 /api/v1/internal/* 整组 403;接入外部服务时必配
INTERNAL_API_KEY=

# --- 语义检索(S3/E1-6 启用,决策 D12)---
# embedding 端点(外部模型服务暴露的无状态接口,如信号服务的 /embed 或公共 embedding API)
# 线约:POST {"inputs":["文本"]} → {"embeddings":[[512 float]]},可选 Bearer 认证(见 architecture.md D12)
# 不配置则语义检索不可用,关键词检索照常;文档向量与查询向量必须同源(同一端点)
# 本地演示:先 python scripts/embedding_stub.py,再配 http://host.docker.internal:8901/embed
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=

# --- 运行 ---
TZ=Asia/Shanghai
# API 端口绑定:默认仅本机,服务器经 nginx 反代;确需直连再改 0.0.0.0 并自行收紧防火墙
API_BIND=127.0.0.1

# --- 种子账号(首次启动幂等创建;生产务必修改默认密码)---
SEED_USERS_ENABLED=true
SEED_ADMIN_PASSWORD=admin123
SEED_ANALYST_PASSWORD=analyst123
SEED_VIEWER_PASSWORD=viewer123
