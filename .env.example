# Sense2Act 全栈环境变量(复制为 .env;.env 不入库)。全部有本地默认值,不填也能跑。

# --- 服务间认证:后端内部接口 key,collector / signal-worker / agent 共用 ---
INTERNAL_API_KEY=local-dev-internal-key

# --- 采集(collector):信息源在前端「信息源管理」配置 ---
COLLECTOR_POLL_SECONDS=60
# 对同一源站两次请求的最小间隔(秒),礼貌抓取
COLLECTOR_REQUEST_INTERVAL=1

# --- Agent ---
# replay = 零 key 演示回放(examples/tender_medical_ai);live = 真实模型 + 本地爬虫
AGENT_MODE=replay
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 信号服务 ---
# 后端未配置关注画像时的兜底企业画像(相关性门槛依据)
SIGNAL_COMPANY_PROFILE=
# 构建镜像时下载语义模型的镜像站;国内网络用 https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co

# --- 后端(其余变量见 Backend/.env.example,同名即可覆盖)---
POSTGRES_PASSWORD=sense2act
JWT_SECRET=local-dev-secret-0123456789abcdef
SEED_ADMIN_PASSWORD=admin123
SEED_ANALYST_PASSWORD=analyst123
SEED_VIEWER_PASSWORD=viewer123
