# Sense2Act 生产环境变量:复制为仓库根目录 .env 后填写。
# 留空的必填项会让 docker-compose.prod.yml 拒绝启动,不会带着开发默认值上线。
# 生成随机值:python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- 必填 ---
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
# 首次启动建的三个种子账号的密码(之后可在库里改,或设 SEED_USERS_ENABLED=false 不再补种)
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_VIEWER_PASSWORD=

# --- 网络 ---
# 前端容器绑定的本机端口,宿主机 nginx 反代到这里(deploy/nginx.conf.example)
WEB_PORT=8088
# 国内服务器构建镜像时下载语义模型的镜像站
HF_ENDPOINT=https://hf-mirror.com

# --- Agent ---
# replay 回放录制案例(零 key);接真实模型改为 live 并填 DEEPSEEK_API_KEY
AGENT_MODE=replay
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 采集与信号(可选,默认值见根目录 .env.example)---
COLLECTOR_POLL_SECONDS=60
COLLECTOR_REQUEST_INTERVAL=1
SIGNAL_NEWS_CONFIG=
