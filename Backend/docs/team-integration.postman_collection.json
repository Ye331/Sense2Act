    {
      "name": "03 爬虫：领取、提交、回报",
      "item": [
        {
          "name": "读取到期源",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/ingest-queue",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "if (!pm.environment.get(\"source_id\") && data.items.length) pm.environment.set(\"source_id\", data.items[0].source_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "提交带原文的文档（可重复验证去重）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/documents",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_id\": \"{{source_id}}\",\n  \"items\": [\n    {\n      \"url\": \"https://example.com/team/{{run_id}}/notice\",\n      \"doc_type\": \"announcement\",\n      \"title\": \"团队联调采购公告 {{run_id}}\",\n      \"org_name\": \"团队联调医院\",\n      \"amount\": \"3250000.00\",\n      \"publish_date\": \"{{publish_date}}\",\n      \"region\": \"华东/联调市\",\n      \"category\": \"医疗信息化\",\n      \"content_text\": \"团队联调采购AI辅助诊断系统，预算325万元。实例 {{run_id}}\",\n      \"raw_html\": \"<html><body>团队联调采购AI辅助诊断系统，预算325万元。实例 {{run_id}}</body></html>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"run_id\")) pm.environment.set(\"run_id\", String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "if (data.document_ids.length) pm.environment.set(\"document_id\", data.document_ids[0]);",
                  "for (const key of [\"accepted\",\"duplicates\",\"failed\"]) pm.environment.set(\"ingest_\"+key, String(data[key]));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "回报抓取结果",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/ingest-runs",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_id\": \"{{source_id}}\",\n  \"ok\": true,\n  \"stats\": {\n    \"fetched\": 1,\n    \"accepted\": {{ingest_accepted}},\n    \"duplicates\": {{ingest_duplicates}},\n    \"failed\": {{ingest_failed}}\n  },\n  \"errors\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 检测服务：规则、原料、信号",
      "item": [
        {
          "name": "读取启用规则",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/signal-rules",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "const rule = data.find(r => r.type === \"amount_anomaly\");",
                  "if (rule) { pm.environment.set(\"rule_id\", rule.id); pm.environment.set(\"rule_version\", String(rule.version)); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "读取待检测文档",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/detection-queue?limit=50",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "if (!pm.environment.get(\"document_id\") && data.items.length) pm.environment.set(\"document_id\", data.items[0].document.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "推送信号（默认等待人工调查）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/signals",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": {\n    \"id\": \"{{document_id}}\"\n  },\n  \"hits\": [\n    {\n      \"rule_type\": \"amount_anomaly\",\n      \"rule_id\": \"{{rule_id}}\",\n      \"rule_version\": {{rule_version}},\n      \"weight\": 0.6,\n      \"detail\": {\n        \"z\": 5.93\n      }\n    }\n  ],\n  \"score\": 0.6,\n  \"detector\": \"team-demo-{{run_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "pm.environment.set(\"signal_id\", data.signal_id); pm.environment.set(\"auto_investigated\", String(data.auto_investigated));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "完成本次文档扫描",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/detection-scan-complete",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_ids\": [\n    \"{{document_id}}\"\n  ],\n  \"detector\": \"team-demo-{{run_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Agent：领取至报告完成",
      "item": [
        {
          "name": "查询待领取调查",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "{{internal_api_key}}"
              }
            ],
            "url": "{{base_url}}/api/v1/internal/investigations?status=created",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "const found = data.items.find(i => i.signal_id === pm.environment.get(\"signal_id\"));",
                  "if (found) pm.environment.set(\"investigation_id\", found.id);",
                  "else if (!pm.environment.get(\"investigation_id\") && data.items.length) pm.environment.set(\"investigation_id\", data.items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "开始调查（CAS 占用）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Internal-Key",
