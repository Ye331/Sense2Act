{
  "info": {
    "_postman_id": "8821d912-4512-4788-92ad-5d9ef16b4f24",
    "name": "Sense2Act 团队联调",
    "description": "按 docs/team-integration.md 顺序联调。先导入并选择环境，填自己的可用凭据；示例信号默认0.60，需要前端人工开启调查。SSE 单独运行。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 后端负责人：准备联调数据",
      "item": [
        {
          "name": "检查服务健康",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "管理员登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "pm.environment.set(\"admin_token\", data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "建立联调信息源",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/sources",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"团队联调-{{run_id}}\",\n  \"type\": \"web_page\",\n  \"url\": \"https://example.com/team/{{run_id}}\",\n  \"adapter\": \"team-demo\",\n  \"schedule_cron\": \"0 0 6 * * *\",\n  \"config\": {},\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"run_id\", String(Date.now()));",
                  "for (const key of [\"source_id\",\"document_id\",\"signal_id\",\"investigation_id\",\"question_id\",\"evidence_id\",\"report_id\"]) pm.environment.set(key, \"\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"请求成功\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "const data = pm.response.json().data;",
                  "pm.environment.set(\"source_id\", data.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
